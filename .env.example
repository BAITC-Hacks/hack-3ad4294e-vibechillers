# Copy to .env and fill in real values; defaults below mirror apps/api/app/config.py.
# LLM API base URL for the OpenAI-compatible chat endpoint.
LLM_BASE_URL=https://api.openai.com/v1
# LLM API key; leave empty to run the degraded, key-less path. Never commit a real key.
LLM_API_KEY=
# Chat model name requested from the LLM endpoint.
LLM_MODEL=gpt-4o-mini
# Per-request LLM timeout in seconds.
LLM_TIMEOUT_S=60.0
# Maximum completion tokens per LLM request.
LLM_MAX_TOKENS=1024
# SQLite database file path (relative paths resolve against the app process).
DB_PATH=data/app.db
# Directory for runtime data such as uploads and the database.
DATA_DIR=data
# Directory holding seed corpus files.
SEEDS_DIR=seeds
# Sentence-transformers model id used for embeddings.
EMBED_MODEL=BAAI/bge-m3
# Dimensionality of the embedding vectors produced by EMBED_MODEL.
EMBED_DIM=1024
# Host/interface the API server binds to.
API_HOST=0.0.0.0
# Port the API server listens on.
API_PORT=8000
# Comma-separated list of allowed CORS origins ("*" allows any origin).
CORS_ORIGINS=*
# Base URL of the API as seen by the web app (not read by apps/api config).
NEXT_PUBLIC_API_BASE=http://localhost:8000
